# Local development settings (copy to backend/.env, or let install.py / ./setup.sh write it with a random secret).
# Never commit backend/.env. For Docker / production use the root .env.example instead.
ENVIRONMENT=development
# at least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# empty = SQLite file backend/data/lti.db; PostgreSQL: postgresql://user:password@localhost:5432/lti
DATABASE_URL=
WORKER_MODE=inline
PRELOAD_MODELS=true
ALLOW_REGISTRATION=true
ALLOW_SYNTHETIC_MODELS=false
MAIL_BACKEND=file
FRONTEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
RETENTION_DAYS=30
LOG_JSON=false
# V11 comparison / benchmark settings (defaults shown)
COMPARE_MAX_CONCURRENT_RUNS=2
COMPARE_MODEL_WORKERS_PER_FAMILY=1
COMPARE_RUN_TIMEOUT_S=300
# LTI_DATASET_DIR=/path/to/liver_ct_lits_verified_v8   # full dataset elsewhere than dataset/
