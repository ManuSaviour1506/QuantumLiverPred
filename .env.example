# Copy to .env and adjust. Never commit .env. Values shown are examples, not secrets in use.
ENVIRONMENT=development                 # development | test | production
# Required in production: at least 32 random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
# PostgreSQL in Docker / production; SQLite file is used when empty (development only)
DATABASE_URL=postgresql://lti:change-me@db:5432/lti
POSTGRES_USER=lti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lti
AUTO_MIGRATE=false                      # production: run `python -m app.db.migrate upgrade` explicitly
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080 # used in password-reset links
ALLOW_REGISTRATION=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Storage for uploads and generated images (mount a persistent volume here)
STORAGE_BACKEND=local                   # local | s3
STORAGE_DIR=/srv/data/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
MAX_UPLOAD_MB=20
MAX_DATASET_UPLOAD_MB=500
RETENTION_DAYS=30                       # uploads and predictions older than this are purged by `python -m app.manage purge-expired`
STORE_ORIGINAL_FILENAMES=true
# Background jobs: inline (threads in the API process) or external (separate `python -m app.worker`)
WORKER_MODE=external
WORKER_THREADS=2
PRELOAD_MODELS=true
# Four-paradigm comparison (runs execute inside the API process; each run starts 4 family pipelines concurrently)
COMPARE_MAX_CONCURRENT_RUNS=2           # comparison runs executing at the same time
COMPARE_MODEL_WORKERS_PER_FAMILY=1      # models at once inside a family (1 = no CPU oversubscription, cleaner timings)
COMPARE_RUN_TIMEOUT_S=300               # models not started by then are reported as "timeout"
LTI_LIVER_MIN_UNET_PX=4096              # U-Net liver-area minimum of the liver validation (see reports/v10/LIVER_GATE_VALIDATION.md)
ALLOW_SYNTHETIC_MODELS=false            # never true in production
# Server-side dataset folders that administrators may register (comma-separated)
DATASET_ROOTS=/data
# Full CT dataset for training scripts and V11 benchmark runs (default: dataset/liver_ct_lits_verified_v8 if present)
LTI_DATASET_DIR=/data/liver_ct_lits_verified_v8
# E-mail for password reset: disabled | smtp | file
MAIL_BACKEND=disabled
MAIL_FROM=no-reply@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RATE_LIMIT_AUTH=10/minute                # register / login / password reset, per client IP
RATE_LIMIT_REFRESH=60/minute            # token refresh (single-use rotating tokens); every page load refreshes
RATE_LIMIT_PREDICT=30/minute
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=                             # optional error-monitoring hook (not wired to a vendor SDK)
# Frontend build (Vercel or other static hosting): base URL of the API, empty = same origin
API_BASE_URL=
